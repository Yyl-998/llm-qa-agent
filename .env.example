# ============ 大模型配置（默认 DeepSeek，可随时切换为任意 OpenAI 兼容服务） ============
# DeepSeek API Key: https://platform.deepseek.com 申请
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
TEMPERATURE=0.3

# ============ Embedding 配置（RAG 知识检索用） ============
# 方式一（默认）：EMBEDDING_MODEL 留空 -> 使用本地 fastembed 的 bge 中文模型，
#   无需额外 key，首次使用知识库时自动下载约 90MB 模型（默认走 hf-mirror.com 镜像）
EMBEDDING_MODEL=
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
# HF_ENDPOINT=https://hf-mirror.com

# 方式二：使用 OpenAI 兼容 embedding 接口（例如阿里 DashScope）
# EMBEDDING_MODEL=deep seek v4 pro
# EMBEDDING_BASE_URL=https://platform.deepseek.com//deep seek v4 pro//v1
# EMBEDDING_API_KEY=sk-your-dashscope-key

# ============ 服务配置 ============
# 会话记忆保留的最近对话轮数
MAX_HISTORY_TURNS=10
